#!/usr/bin/env bash
# One-click launcher for the photo-client Linux desktop app and the Android app.
#
#   tools/run_app release            run the built release bundle (foreground)
#   tools/run_app release --build    build current sources, then run
#   tools/run_app dev                flutter run -d linux (debug, hot reload)
#   tools/run_app android            build/install/launch the Android app
#
# By default this is your REAL environment: your real desktop (native Wayland
# when present, else X11) and the app's real default library
# ($XDG_DATA_HOME/photo-client/library, else ~/.local/share/...). No isolation.
# Only automated test cases use isolation: --headless and --data-root DIR.
#
# Display selection: native Wayland when the user session exposes one, else
# X11/XWayland; --x11 forces X11, --headless runs on a private Xvfb display so
# nothing appears on (or injects into) the real desktop.
#
# Android selection: the app runs on a real emulator or a connected device.
# The Android emulator defaults to the host GPU because the SwiftShader
# fallback crashes the guest display pipeline on some hosts.
# Use a headless, low-memory guest with Vulkan disabled by default.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUNDLE="$ROOT/app/build/linux/x64/release/bundle/photo_client"

ANDROID_PROFILE="android-universal"
ANDROID_APK="$ROOT/app/build/app/outputs/flutter-apk/app-release.apk"
ANDROID_PACKAGE="com.photoviewer.photo_client"
ANDROID_ACTIVITY="$ANDROID_PACKAGE/.MainActivity"

mode="release"
data_root=""
display_mode="auto"
do_build=0
background=0
XVFB_PID=""
APP_PID=""

android_device=""
android_abi=""
android_avd="photo36"
android_gpu="host"
android_headless=1
android_no_avd=0

usage() {
  cat <<'EOF'
Usage: tools/run_app [release|dev|android] [options]

Modes:
  release            run the built release bundle (default)
  dev                run `flutter run -d linux` (debug, hot reload, foreground)
  android            build/install/launch the Android app on an emulator or device

Options:
  --data-root DIR    (tests only) override the library data root
                     (default: the app's real default library, no isolation)
  --x11              force X11/XWayland instead of native Wayland
  --headless         private Xvfb display; no window on your desktop (test only)
  --build            (release, android) rebuild via tools/platform before running
  --background       (release) detach with nohup; print PID and log path
  -h, --help         show this help

Android options:
  --device SERIAL    target this adb device (default: the only online device)
  --android-abi ABI  build/install a split APK: arm64-v8a, armeabi-v7a or x86_64
  --avd NAME         AVD to boot when no device is online (default: photo36)
  --no-avd           never start an emulator; fail if no device is online
  --gpu MODE         emulator GPU backend (default: host)
  --no-window        run the emulator headless (default)
  --window           show the emulator window on the desktop
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    release|dev|android) mode="$1"; shift ;;
    --data-root)
      if [ $# -lt 2 ] || [ -z "$2" ] || [[ "$2" == --* ]]; then
        echo "run_app: --data-root needs a directory" >&2
        exit 2
      fi
      data_root="$2"; shift 2 ;;
    --x11) display_mode="x11"; shift ;;
    --headless) display_mode="headless"; shift ;;
    --build) do_build=1; shift ;;
    --background) background=1; shift ;;
    --device)
      if [ $# -lt 2 ] || [ -z "$2" ] || [[ "$2" == --* ]]; then
        echo "run_app: --device needs a serial" >&2
        exit 2
      fi
      android_device="$2"; shift 2 ;;
    --android-abi)
      if [ $# -lt 2 ]; then
        echo "run_app: --android-abi needs an ABI" >&2
        exit 2
      fi
      case "$2" in
        arm64-v8a|armeabi-v7a|x86_64) android_abi="$2" ;;
        *) echo "run_app: unsupported Android ABI: $2" >&2; exit 2 ;;
      esac
      shift 2 ;;
    --avd)
      if [ $# -lt 2 ] || [ -z "$2" ] || [[ "$2" == --* ]]; then
        echo "run_app: --avd needs a name" >&2
        exit 2
      fi
      android_avd="$2"; shift 2 ;;
    --no-avd) android_no_avd=1; shift ;;
    --gpu)
      if [ $# -lt 2 ] || [ -z "$2" ] || [[ "$2" == --* ]]; then
        echo "run_app: --gpu needs a backend name" >&2
        exit 2
      fi
      android_gpu="$2"; shift 2 ;;
    --no-window) android_headless=1; shift ;;
    --window) android_headless=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "run_app: unknown argument: $1" >&2; usage; exit 2 ;;
  esac
done

if [ -n "$android_abi" ] && [ "$mode" != "android" ]; then
  echo "run_app: --android-abi only applies to android" >&2
  exit 2
fi

if [ -n "$data_root" ]; then
  data_root="$(python3 -B - "$data_root" <<'PY'
from pathlib import Path
import sys
print(Path(sys.argv[1]).expanduser().absolute())
PY
)"
fi

if [ "$mode" = "dev" ] && [ "$background" = 1 ]; then
  echo "run_app: dev uses foreground hot reload; --background requires release" >&2
  exit 2
fi
if [ "$mode" = "dev" ] && [[ "$data_root" == *,* ]]; then
  echo "run_app: Flutter dev splits arguments at commas; use a data-root without commas" >&2
  exit 2
fi

setup_flutter() {
  if [ -n "${PHOTO_FLUTTER_ROOT:-}" ]; then
    if [ ! -x "$PHOTO_FLUTTER_ROOT/bin/flutter" ]; then
      echo "run_app: PHOTO_FLUTTER_ROOT/bin/flutter is not executable" >&2
      exit 2
    fi
    export PATH="$PHOTO_FLUTTER_ROOT/bin:$PATH"
  elif command -v flutter >/dev/null 2>&1; then
    return
  else
    local sdk="${XDG_DATA_HOME:-$HOME/.local/share}/photo-client/flutter"
    if [ ! -x "$sdk/bin/flutter" ]; then
      echo "run_app: Flutter not found; set PHOTO_FLUTTER_ROOT or add flutter to PATH" >&2
      exit 2
    fi
    export PHOTO_FLUTTER_ROOT="$sdk" PATH="$sdk/bin:$PATH"
  fi
}

cleanup() {
  if [ -n "$APP_PID" ]; then
    kill "$APP_PID" 2>/dev/null || true
    wait "$APP_PID" 2>/dev/null || true
  fi
  if [ -n "$XVFB_PID" ]; then
    kill "$XVFB_PID" 2>/dev/null || true
    wait "$XVFB_PID" 2>/dev/null || true
  fi
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Keep the parent alive to own/reap Xvfb, including when running Flutter dev.
run_foreground() {
  if [ "$display_mode" = "headless" ]; then
    "$@" <&0 &
    APP_PID=$!
    local status=0
    wait "$APP_PID" || status=$?
    APP_PID=""
    return "$status"
  fi
  exec "$@"
}

# An empty data_root means "let the app use its real default library"; we then
# pass no --data-root at all, so there is no isolation by default.
data_root_label="${data_root:-<app real default>}"

setup_display() {
  if [ "$display_mode" = "headless" ]; then
    local n
    for n in $(seq 99 -1 90); do
      [ -e "/tmp/.X$n-lock" ] && continue
      Xvfb ":$n" -screen 0 1440x900x24 -nolisten tcp >/dev/null 2>&1 &
      XVFB_PID=$!
      sleep 1.2
      if kill -0 "$XVFB_PID" 2>/dev/null; then
        export DISPLAY=":$n" GDK_BACKEND=x11 LIBGL_ALWAYS_SOFTWARE=1
        unset WAYLAND_DISPLAY || true
        return 0
      fi
      wait "$XVFB_PID" 2>/dev/null || true
      XVFB_PID=""
    done
    echo "run_app: no free Xvfb display in :90..:99" >&2
    exit 1
  fi
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
  if [ "$display_mode" = "x11" ]; then
    export GDK_BACKEND=x11 DISPLAY="${DISPLAY:-:0}"
    unset WAYLAND_DISPLAY || true
  elif [ -S "${WAYLAND_DISPLAY:-$XDG_RUNTIME_DIR/wayland-0}" ] ||
       [ -S "$XDG_RUNTIME_DIR/${WAYLAND_DISPLAY:-wayland-0}" ]; then
    export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
    unset GDK_BACKEND || true
  else
    export GDK_BACKEND=x11 DISPLAY="${DISPLAY:-:0}"
    unset WAYLAND_DISPLAY || true
  fi
}

android_sdk_root() {
  local candidate
  for candidate in "${ANDROID_HOME:-}" "${ANDROID_SDK_ROOT:-}"; do
    if [ -n "$candidate" ] && [ -d "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  local properties="$ROOT/app/android/local.properties"
  if [ -f "$properties" ]; then
    candidate="$(sed -n 's/^sdk\.dir=//p' "$properties" | head -1 | sed 's/\\:/:/g; s/\\\\/\\/g')"
    if [ -n "$candidate" ] && [ -d "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi
  candidate="$HOME/Android/Sdk"
  if [ -d "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  return 1
}

# Online devices only: "offline" or "unauthorized" serials are not usable.
android_devices() {
  "$ANDROID_ADB" devices | awk 'NR > 1 && $2 == "device" { print $1 }'
}

android_boot_complete() {
  "$ANDROID_ADB" -s "$1" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r'
}

# True when an emulator process for this AVD is alive, whether it is still
# booting or already up.
emulator_running() {
  pgrep -f "qemu-system.*-avd $1" >/dev/null 2>&1
}

# The emulator keeps running after this script returns, so it needs its own
# session; a plain background job would be reaped with the caller's group.
start_android_emulator() {
  local avd="$1"
  local emulator="$ANDROID_SDK/emulator/emulator"
  if [ ! -x "$emulator" ]; then
    echo "run_app: emulator not found: $emulator" >&2
    exit 1
  fi
  local log="${TMPDIR:-/tmp}/photo-client-emulator-$avd.log"
  # Low-RAM mode keeps the configured RAM instead of increasing it to 2560 MB.
  # Disabling Vulkan also avoids large host GPU allocations on this machine.
  local -a args=(-avd "$avd" -gpu "$android_gpu" -lowram -feature -Vulkan -no-boot-anim -no-audio -no-snapshot)
  if [ "$android_headless" = 1 ]; then args+=(-no-window); fi
  # A previous instance of this AVD can still be shutting down and holding the
  # AVD lock; starting a second one then fails silently. Wait it out.
  local deadline=$((SECONDS + 90))
  while emulator_running "$avd"; do
    if [ "$SECONDS" -ge "$deadline" ]; then
      echo "run_app: previous emulator for $avd is still shutting down" >&2
      exit 1
    fi
    sleep 2
  done
  setsid "$emulator" "${args[@]}" >"$log" 2>&1 </dev/null &
  echo "run_app: emulator starting avd=$avd gpu=$android_gpu log=$log"
}

# Wait for a booted device; prints the serial it settled on.
wait_android_device() {
  local deadline=$((SECONDS + 180))
  while [ "$SECONDS" -lt "$deadline" ]; do
    local serial
    serial="$(android_devices | head -1)"
    if [ -n "$serial" ] && [ "$(android_boot_complete "$serial")" = "1" ]; then
      printf '%s\n' "$serial"
      return 0
    fi
    sleep 2
  done
  return 1
}

if [ "$mode" = "android" ]; then
  if [ "$background" = 1 ]; then
    echo "run_app: --background does not apply to android; the app runs on the device" >&2
    exit 2
  fi
  if [ -n "$data_root" ]; then
    echo "run_app: --data-root does not apply to android; the library lives on the device" >&2
    exit 2
  fi
  if [ "$display_mode" != "auto" ]; then
    echo "run_app: --x11/--headless only apply to the Linux desktop app" >&2
    exit 2
  fi
  ANDROID_SDK="$(android_sdk_root)" || {
    echo "run_app: Android SDK not found; set ANDROID_HOME or ANDROID_SDK_ROOT" >&2
    exit 2
  }
  ANDROID_ADB="$ANDROID_SDK/platform-tools/adb"
  if [ ! -x "$ANDROID_ADB" ]; then
    echo "run_app: adb not found: $ANDROID_ADB" >&2
    exit 2
  fi
  export ANDROID_HOME="$ANDROID_SDK" ANDROID_SDK_ROOT="$ANDROID_SDK"

  serial="$android_device"
  if [ -z "$serial" ]; then
    serial="$(android_devices | head -1)"
  fi
  if [ -z "$serial" ]; then
    if [ "$android_no_avd" = 1 ]; then
      echo "run_app: no online Android device; start one or drop --no-avd" >&2
      exit 1
    fi
    if emulator_running "$android_avd"; then
      # The AVD is already booting: adb has not registered it yet. Starting a
      # second instance would only fight over the AVD lock, so wait instead.
      serial="$(wait_android_device)" || {
        echo "run_app: emulator $android_avd did not finish booting" >&2
        exit 1
      }
    else
      # One retry: the first attempt can lose a race with a shutting-down
      # instance that still holds the AVD lock.
      for attempt in 1 2; do
        start_android_emulator "$android_avd"
        if serial="$(wait_android_device)"; then
          break
        fi
        if [ "$attempt" = 2 ]; then
          echo "run_app: emulator $android_avd did not finish booting" >&2
          exit 1
        fi
        echo "run_app: emulator $android_avd did not come up; retrying" >&2
      done
    fi
  fi
  echo "run_app: android device=$serial"
  if [ -n "$android_abi" ]; then
    ANDROID_APK="$ROOT/app/build/app/outputs/flutter-apk/app-$android_abi-release.apk"
  fi

  if [ "$do_build" = 1 ] || [ ! -f "$ANDROID_APK" ]; then
    setup_flutter
    android_build_args=(python3 -B "$ROOT/tools/platform" build --profile "$ANDROID_PROFILE" --mode release)
    if [ -n "$android_abi" ]; then
      android_build_args+=(--android-abi "$android_abi")
    fi
    "${android_build_args[@]}"
  fi
  if [ ! -f "$ANDROID_APK" ]; then
    echo "run_app: APK not found: $ANDROID_APK" >&2
    exit 1
  fi

  "$ANDROID_ADB" -s "$serial" install -r "$ANDROID_APK"
  # Installing over a running app makes Android relaunch it on its own. That
  # second launch races with ours and leaves two Flutter engines in one
  # process, where the native runtime refuses to initialize twice and the
  # library comes up empty. Stop the package so exactly one launch happens.
  "$ANDROID_ADB" -s "$serial" shell am force-stop "$ANDROID_PACKAGE"
  sleep 1
  # The library is path-based like the desktop build, so it needs the all-files
  # contract plus media reads. The grant is a real system grant, not a stub.
  "$ANDROID_ADB" -s "$serial" shell appops set "$ANDROID_PACKAGE" MANAGE_EXTERNAL_STORAGE allow || true
  for permission in READ_MEDIA_IMAGES READ_MEDIA_VIDEO; do
    "$ANDROID_ADB" -s "$serial" shell pm grant "$ANDROID_PACKAGE" "android.permission.$permission" || true
  done
  "$ANDROID_ADB" -s "$serial" shell am start -n "$ANDROID_ACTIVITY"
  echo "run_app: launched $ANDROID_ACTIVITY on $serial"
  echo "run_app: logs: $ANDROID_ADB -s $serial logcat --pid=\$(pidof $ANDROID_PACKAGE)"
  exit 0
fi

if [ "$mode" = "dev" ]; then
  setup_flutter
  # `flutter run` alone cannot bring the app up: the Dart side requires the
  # generated PHOTO_PROFILE_* dart-defines (otherwise the core refuses to
  # initialize with BuildProfileMissing), and the runner only installs whatever
  # target/debug/libphoto_bridge.so already exists. Mirror the declarative
  # profile steps from tools/platform, then hand off to `flutter run` so hot
  # reload keeps working.
  python3 -B "$ROOT/tools/platform" generate --profile linux-x86_64 >/dev/null
  defines_file="$ROOT/.build/linux-x86_64/dart-defines.json"
  # The native library embeds the profile digest at compile time and the Dart
  # side embeds the same values, so both must be built from one profile.
  eval "$(python3 -B - "$defines_file" <<'PY'
import json, shlex, sys

for key, value in json.load(open(sys.argv[1], encoding="utf-8")).items():
    print(f"export {key}={shlex.quote(value)}")
PY
)"
  native_library="$ROOT/target/debug/libphoto_bridge.so"
  export CARGO_TARGET_DIR="$ROOT/target" PHOTO_NATIVE_LIB_DIR="$ROOT/target/debug"
  echo "run_app: dev building native core (cargo build -p photo-bridge)"
  if ! (cd "$ROOT" && python3 -B "$ROOT/tools/prepare_linux_media.py" exec cargo build --locked -p photo-bridge); then
    echo "run_app: dev native core build failed" >&2
    exit 1
  fi
  if [ ! -f "$native_library" ]; then
    echo "run_app: dev missing native library: $native_library" >&2
    exit 1
  fi
  cd "$ROOT/app"
  setup_display
  display_label="${WAYLAND_DISPLAY:-${DISPLAY:-}}"
  echo "run_app: dev (flutter run -d linux) data-root=$data_root_label display=$display_label"
  flutter_args=(--no-version-check run -d linux "--dart-define-from-file=$defines_file")
  if [ -n "$data_root" ]; then
    flutter_args+=("--dart-entrypoint-args=--data-root=$data_root")
  fi
  run_foreground python3 -B "$ROOT/tools/prepare_linux_media.py" exec flutter "${flutter_args[@]}"
  exit $?
fi

if [ "$do_build" = 1 ] || [ ! -x "$BUNDLE" ]; then
  setup_flutter
  python3 -B "$ROOT/tools/platform" build --profile linux-x86_64 --mode release
fi

setup_display
display_label="${WAYLAND_DISPLAY:-${DISPLAY:-}}"
app_args=()
if [ -n "$data_root" ]; then app_args=(--data-root="$data_root"); fi

echo "run_app: release data-root=$data_root_label display=$display_label"
if [ "$display_mode" = "headless" ]; then
  # The script must stay alive to hold the Xvfb display, so --background is
  # incompatible here; the EXIT trap reaps Xvfb when the app stops.
  if [ "$background" = 1 ]; then
    echo "run_app: --background ignored with --headless; running foreground" >&2
  fi
  run_foreground "$BUNDLE" "${app_args[@]}"
  exit $?
fi

if [ "$background" = 1 ]; then
  log="${TMPDIR:-/tmp}/photo-client-release.log"
  nohup "$BUNDLE" "${app_args[@]}" >"$log" 2>&1 &
  echo "run_app: PID=$! log=$log"
else
  run_foreground "$BUNDLE" "${app_args[@]}"
fi
