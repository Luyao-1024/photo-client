#!/usr/bin/env bash
# One-click launcher for the photo-client Linux desktop app.
#
#   tools/run_app release            run the built release bundle (foreground)
#   tools/run_app dev                flutter run -d linux (debug, hot reload)
#
# By default this is your REAL environment: your real desktop (native Wayland
# when present, else X11) and the app's real default library
# ($XDG_DATA_HOME/photo-client/library, else ~/.local/share/...). No isolation.
# Isolation is opt-in only: --headless (private Xvfb) and --data-root DIR.
#
# Display selection: native Wayland when the user session exposes one, else
# X11/XWayland; --x11 forces X11, --headless runs on a private Xvfb display so
# nothing appears on (or injects into) the real desktop.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FLUTTER_ROOT="${PHOTO_FLUTTER_ROOT:-$HOME/.local/share/photo-client/flutter}"
BUNDLE="$ROOT/app/build/linux/x64/release/bundle/photo_client"

mode="release"
data_root=""
display_mode="auto"
do_build=0
background=0
XVFB_PID=""

usage() {
  cat <<'EOF'
Usage: tools/run_app [release|dev] [options]

Modes:
  release            run the built release bundle (default)
  dev                run `flutter run -d linux` (debug, hot reload, foreground)

Options:
  --data-root DIR    override the library data root
                     (default: the app's real default library, no isolation)
  --x11              force X11/XWayland instead of native Wayland
  --headless         private Xvfb display; no window on your desktop (test only)
  --build            (release) rebuild via tools/platform before running
  --background       detach with nohup; print PID and log path
  -h, --help         show this help
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    release|dev) mode="$1"; shift ;;
    --data-root) data_root="${2:?--data-root needs a value}"; shift 2 ;;
    --x11) display_mode="x11"; shift ;;
    --headless) display_mode="headless"; shift ;;
    --build) do_build=1; shift ;;
    --background) background=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "run_app: unknown argument: $1" >&2; usage; exit 2 ;;
  esac
done

export PATH="$FLUTTER_ROOT/bin:$PATH"

# An empty data_root means "let the app use its real default library"; we then
# pass no --data-root at all, so there is no isolation by default.
data_root_label="${data_root:-<app real default>}"

setup_display() {
  if [ "$display_mode" = "headless" ]; then
    local n
    for n in $(seq 99 -1 90); do
      [ -e "/tmp/.X$n-lock" ] && continue
      Xvfb ":$n" -screen 0 1440x900x24 -nolisten tcp >/dev/null 2>&1 &
      XVFB_PID=$!
      sleep 1.2
      if kill -0 "$XVFB_PID" 2>/dev/null; then
        export DISPLAY=":$n" GDK_BACKEND=x11 LIBGL_ALWAYS_SOFTWARE=1
        unset WAYLAND_DISPLAY || true
        trap '[ -n "$XVFB_PID" ] && kill "$XVFB_PID" 2>/dev/null' EXIT
        return 0
      fi
    done
    echo "run_app: no free Xvfb display in :90..:99" >&2
    exit 1
  fi
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
  if [ "$display_mode" = "x11" ]; then
    export GDK_BACKEND=x11 DISPLAY="${DISPLAY:-:1}"
  elif [ -S "$XDG_RUNTIME_DIR/wayland-0" ]; then
    export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
    unset GDK_BACKEND || true
  else
    export GDK_BACKEND=x11 DISPLAY="${DISPLAY:-:0}"
  fi
}

setup_display
display_label="${WAYLAND_DISPLAY:-$DISPLAY}"

if [ "$mode" = "dev" ]; then
  # `flutter run` alone cannot bring the app up: the Dart side requires the
  # generated PHOTO_PROFILE_* dart-defines (otherwise the core refuses to
  # initialize with BuildProfileMissing), and the runner only installs whatever
  # target/debug/libphoto_bridge.so already exists. Mirror the declarative
  # profile steps from tools/platform, then hand off to `flutter run` so hot
  # reload keeps working.
  python3 -B "$ROOT/tools/platform" generate --profile linux-x86_64 >/dev/null
  defines_file="$ROOT/.build/linux-x86_64/dart-defines.json"
  # The native library embeds the profile digest at compile time and the Dart
  # side embeds the same values, so both must be built from one profile.
  eval "$(python3 -B - "$defines_file" <<'PY'
import json, shlex, sys

for key, value in json.load(open(sys.argv[1], encoding="utf-8")).items():
    print(f"export {key}={shlex.quote(value)}")
PY
)"
  native_library="$ROOT/target/debug/libphoto_bridge.so"
  echo "run_app: dev building native core (cargo build -p photo-bridge)"
  if ! (cd "$ROOT" && cargo build --locked -p photo-bridge); then
    echo "run_app: dev native core build failed" >&2
    exit 1
  fi
  if [ ! -f "$native_library" ]; then
    echo "run_app: dev missing native library: $native_library" >&2
    exit 1
  fi
  cd "$ROOT/app"
  echo "run_app: dev (flutter run -d linux) data-root=$data_root_label display=$display_label"
  if [ -n "$data_root" ]; then
    exec python3 "$ROOT/tools/prepare_linux_media.py" exec flutter run -d linux --dart-define-from-file="$defines_file" -- --data-root="$data_root"
  fi
  exec python3 "$ROOT/tools/prepare_linux_media.py" exec flutter run -d linux --dart-define-from-file="$defines_file"
fi

if [ "$do_build" = 1 ] || [ ! -x "$BUNDLE" ]; then
  python3 -B "$ROOT/tools/platform" build --profile linux-x86_64 --mode release
fi

app_args=()
if [ -n "$data_root" ]; then app_args=(--data-root="$data_root"); fi

echo "run_app: release data-root=$data_root_label display=$display_label"
if [ "$display_mode" = "headless" ]; then
  # The script must stay alive to hold the Xvfb display, so --background is
  # incompatible here; the EXIT trap reaps Xvfb when the app stops.
  if [ "$background" = 1 ]; then
    echo "run_app: --background ignored with --headless; running foreground" >&2
  fi
  "$BUNDLE" "${app_args[@]}" &
  app_pid=$!
  wait "$app_pid"
  exit 0
fi

if [ "$background" = 1 ]; then
  log="${TMPDIR:-/tmp}/photo-client-release.log"
  nohup "$BUNDLE" "${app_args[@]}" >"$log" 2>&1 &
  echo "run_app: PID=$! log=$log"
else
  exec "$BUNDLE" "${app_args[@]}"
fi
