  "accent": {
    "source": "system_when_available",
    "fallback": "#4F8EFF"
  },
  "light": {
    "background": "#EEF1F6",
    "foreground": "#172033",
    "glass_fill": "#FFFFFF",
    "glass_alpha": 0.25,
    "reading_fill": "#FFFFFF",
    "reading_alpha_floor": 0.94,
    "highlight": "#FFFFFF",
    "highlight_alpha": 0.7,
    "shadow": "#000000",
    "shadow_alpha": 0.16,
    "chrome_alpha_floor": 0.12
  },
  "dark": {
    "background": "#121721",
    "foreground": "#F3F6FC",
    "glass_fill": "#17202E",
    "glass_alpha": 0.25,
    "reading_fill": "#17202E",
    "reading_alpha_floor": 0.94,
    "highlight": "#FFFFFF",
    "highlight_alpha": 0.16,
    "shadow": "#000000",
    "shadow_alpha": 0.3,
    "chrome_alpha_floor": 0.12
  },
