{
  "contract_version": 1,
  "purpose": "design_reference_with_shared_flutter_material_tokens",
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "radius": {
    "photo": 8,
    "control": 12,
    "panel": 18,
    "dialog": 24,
    "pill": 999,
    "window": 24
  },
  "sizes": {
    "toolbar_height": 56,
    "touch_target_min": 48,
    "mouse_target_min": 36,
    "grid_gap": 8,
    "grouping_control_width": 216,
    "page_action_diameter": 48
  },
  "accent": {
    "source": "neutral_monochrome",
    "fallback": "#808080"
  },
  "light": {
    "background": "#F5F5F5",
    "foreground": "#1B1B1B",
    "glass_fill": "#FFFFFF",
    "glass_alpha": 0.22,
    "reading_fill": "#FFFFFF",
    "reading_alpha_floor": 0.94,
    "highlight": "#FFFFFF",
    "highlight_alpha": 0,
    "shadow": "#000000",
    "shadow_alpha": 0.16,
    "chrome_alpha_floor": 0.12
  },
  "dark": {
    "background": "#151515",
    "foreground": "#F1F1F1",
    "glass_fill": "#181818",
    "glass_alpha": 0.22,
    "reading_fill": "#181818",
    "reading_alpha_floor": 0.94,
    "highlight": "#FFFFFF",
    "highlight_alpha": 0,
    "shadow": "#000000",
    "shadow_alpha": 0.3,
    "chrome_alpha_floor": 0.12
  },
  "photo_overlay": {
    "foreground": "#FFFFFF",
    "scrim": "#000000",
    "scrim_alpha_floor": 0.58
  },
  "quality": {
    "default": "full",
    "full": {
      "blur_sigma": 12,
      "max_live_surfaces": 3,
      "max_normal_viewport_area_ratio": 0.2,
      "lens_model": "paraxial",
      "thickness_focal": 42,
      "thickness_other": 32,
      "refractive_index_focal": 1.34,
      "refractive_index_other": 1.26,
      "chromatic_aberration_focal": 0.012,
      "chromatic_aberration_other": 0.006,
      "frost": 6,
      "frost_overlay": 14
    },
    "switchable": false,
    "automatic_tier_switching": false,
    "frost_switching": false
  },
  "motion_ms": {
    "hover": 120,
    "press": 90,
    "material": 180,
    "panel": 220,
    "reduced_fade_max": 80,
    "background": 420
  },
  "contrast_targets": {
    "normal_text": 4.5,
    "large_text_and_controls": 3.0
  },
  "performance": {
    "adaptive_window_ms": 2000,
    "bad_windows_before_degrade": 2,
    "stable_ms_before_upgrade": 10000,
    "min_switch_interval_ms": 5000
  },
  "transparency_mapping": {
    "input_min": 0,
    "input_max": 1,
    "base_alpha_delta": 0.1,
    "normal_max_alpha": 0.98,
    "high_contrast_alpha": 1.0
  },
  "implementation": "app/lib/ui/glass_theme.dart and app/lib/ui/glass_surface.dart",
  "roles": {
    "chrome": {
      "base_alpha": 0.22,
      "floor": 0.1,
      "ceiling": 0.32
    },
    "raised": {
      "base_alpha": 0.18,
      "floor": 0.1,
      "ceiling": 0.28
    },
    "overlay": {
      "base_alpha": 0.52,
      "floor": 0.42,
      "ceiling": 0.62
    },
    "reading": {
      "base_alpha": 0.96,
      "floor": 0.94,
      "ceiling": 0.98
    }
  },
  "perimeter": {
    "normal_border": false,
    "fresnel_strength": 0,
    "rim_light": 0.65,
    "shader_overscan_logical_px": 2,
    "shape": "rounded_superellipse",
    "high_contrast_outline": true,
    "premium_overscan_logical_px": 0
  },
  "ambient_backdrop": {
    "source": "sampled_viewport_photo_else_album_cover_or_first_photo",
    "thumbnail_class": 512,
    "decode_width": 512,
    "blur_sigma": 18,
    "dark_scrim_alpha": 0.56,
    "light_scrim_alpha": 0.72,
    "disabled_in_high_contrast": true,
    "scroll_updates": false,
    "coverage": "full_window",
    "blur_sigma_range": [
      0,
      36
    ],
    "blur_preference": "backgroundBlur"
  },
  "window_layout": {
    "sidebar": "inset_rounded_lens",
    "header": "unframed_heading_with_separate_circular_actions",
    "header_min_height": 92,
    "canvas_horizontal_inset": 20,
    "day_columns": "preserve_user_preference",
    "scroll_content": "beneath_pinned_heading_and_controls",
    "heading_font_size": 24,
    "count_font_size": 12,
    "selection_actions_height": 52,
    "photo_panel_radius": 18,
    "panel_top_inset": 8,
    "panel_bottom_inset": 8,
    "photo_panel_right_inset": 8,
    "photo_panel_tint_alpha": 0.1
  },
  "background_transition": {
    "hold_previous_until_decoded": true,
    "outgoing_opacity": 1,
    "incoming_curve": "easeInOut",
    "max_painted_images": 2,
    "pending_target": "latest_only",
    "reduce_motion": "immediate",
    "failed_target": "retain_previous",
    "clear_immediately": [
      "empty",
      "trash",
      "gateway_change"
    ],
    "viewport_follow": {
      "sample_interval_ms": 1200,
      "settle_delay_ms": 300,
      "target": "visible_middle_photo",
      "top": "saved_cover_or_first_photo",
      "scope": "query_epoch",
      "pending_metadata": "keep_last_complete_background",
      "persists_cover": false,
      "enabled_preference": "followScroll",
      "default_enabled": true,
      "disabled": "saved_album_cover"
    }
  },
  "appearance_controls": [
    "transparency",
    "backgroundBlur",
    "followScroll"
  ]
}
